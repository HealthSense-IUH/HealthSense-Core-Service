<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fit.iuh.se</groupId>
        <artifactId>HealthSense-Api-Service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>hs-assistant</artifactId>
    <name>hs-assistant</name>
    <description>Trợ lý AI của HealthSense: Spring AI + OpenAI, trả lời streaming, tool đọc dữ liệu người dùng</description>
    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.38</lombok.version>
    </properties>
    <dependencies>
        <!-- module nội bộ: dữ liệu mà tool của trợ lý được phép đọc -->
        <dependency>
            <groupId>fit.iuh.se</groupId>
            <artifactId>hs-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fit.iuh.se</groupId>
            <artifactId>hs-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fit.iuh.se</groupId>
            <artifactId>hs-health-record</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fit.iuh.se</groupId>
            <artifactId>hs-consultation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>fit.iuh.se</groupId>
            <artifactId>hs-nutrition</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Spring AI: OpenAI + bộ nhớ hội thoại lưu JDBC (bảng tạo bằng Flyway V31) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-chat-memory-repository-jdbc</artifactId>
        </dependency>
        <!-- dữ liệu -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- utils -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
