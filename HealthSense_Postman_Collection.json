{
  "info": {
    "_postman_id": "c8a32b1a-9f4e-4e3a-b8d1-healthsense2026",
    "name": "HealthSense Core API - Automated Super Admin Test",
    "description": "Bộ sưu tập Postman chuẩn hóa cho HealthSense Core Service. Tự động đăng nhập bằng tài khoản Super Admin mặc định (superadmin@gmail.com / Test123@) và tự động lưu accessToken vào biến của Collection để sử dụng cho toàn bộ các API phía sau.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "avatarUploadUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "avatarPublicUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "avatarS3Key",
      "value": "",
      "type": "string"
    },
    {
      "key": "recordId",
      "value": "",
      "type": "string"
    },
    {
      "key": "recordUploadUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "recordS3Key",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login Super Admin (Auto Save Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
                  "    console.log(\"Đã lưu tự động accessToken vào biến Collection:\", jsonData.data.accessToken);",
                  "    pm.test(\"Login thành công & Đã lưu accessToken\", function () {",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "        pm.expect(jsonData.data.accessToken).to.not.be.empty;",
                  "    });",
                  "} else {",
                  "    pm.test(\"Login thất bại - Vui lòng kiểm tra lại tài khoản Super Admin\", function () {",
                  "        pm.expect(false).to.be.true;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@gmail.com\",\n  \"password\": \"Test123@\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Đăng nhập tài khoản Super Admin mặc định được khởi tạo trong application-dev.properties. Token sẽ được script tự động lấy và gắn vào biến collection {{accessToken}}."
          }
        }
      ]
    },
    {
      "name": "2. User & Avatar Management (Phase 2)",
      "item": [
        {
          "name": "2.1 Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Lấy thông tin profile hiện tại của Super Admin."
          }
        },
        {
          "name": "2.2 Generate Avatar Presigned Upload URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.uploadUrl) {",
                  "    pm.collectionVariables.set(\"avatarUploadUrl\", jsonData.data.uploadUrl);",
                  "    pm.collectionVariables.set(\"avatarPublicUrl\", jsonData.data.publicUrl);",
                  "    pm.collectionVariables.set(\"avatarS3Key\", jsonData.data.s3Key);",
                  "    console.log(\"Đã lưu avatarUploadUrl & avatarPublicUrl vào biến Collection\");",
                  "    pm.test(\"Sinh Presigned URL Avatar thành công\", function () {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "        pm.expect(jsonData.data.uploadUrl).to.include(\"avatars/\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"super_admin_avatar.png\",\n  \"contentType\": \"image/png\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me/avatar/presigned-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me", "avatar", "presigned-url"]
            },
            "description": "Yêu cầu Core Service sinh link Presigned PUT URL để tải ảnh đại diện lên folder avatars/ trên S3."
          }
        },
        {
          "name": "2.3 (Simulate) Put Image to S3 Presigned URL",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "image/png"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "Đây là nội dung giả lập của file ảnh binary PNG (trong thực tế trên Postman bạn chọn body tab 'binary' và pick file ảnh thật để upload lên S3)."
            },
            "url": {
              "raw": "{{avatarUploadUrl}}",
              "host": ["{{avatarUploadUrl}}"]
            },
            "description": "LƯU Ý: Request này bắn TRỰC TIẾP lên AWS S3 (không qua localhost:8080). Trong Postman, chuyển tab Body sang 'binary' và chọn file ảnh .png/.jpg thực tế để test tải file lên S3."
          }
        },
        {
          "name": "2.4 Update Profile with New Avatar (Auto Delete Old)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"System Super Admin (Updated)\",\n  \"avatarUrl\": \"{{avatarPublicUrl}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "me"]
            },
            "description": "Cập nhật avatarUrl mới cho Profile. Nếu trước đó profile đã có ảnh trong folder avatars/, Core Service sẽ tự động gọi s3Service.deleteFile(oldKey) để xóa ảnh cũ."
          }
        }
      ]
    },
    {
      "name": "3. Health Record Management (Phase 1)",
      "item": [
        {
          "name": "3.1 Generate Record Presigned Upload URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.uploadUrl) {",
                  "    pm.collectionVariables.set(\"recordId\", jsonData.data.recordId);",
                  "    pm.collectionVariables.set(\"recordUploadUrl\", jsonData.data.uploadUrl);",
                  "    pm.collectionVariables.set(\"recordS3Key\", jsonData.data.s3Key);",
                  "    console.log(\"Đã lưu recordId & recordUploadUrl vào biến Collection. Record ID:\", jsonData.data.recordId);",
                  "    pm.test(\"Sinh Presigned URL Record thành công\", function () {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "        pm.expect(jsonData.data.s3Key).to.include(\"records/\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"ppg_patient_sample_01.csv\",\n  \"fileSize\": 15420\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/health-records/presigned-url",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health-records", "presigned-url"]
            },
            "description": "Tạo bản ghi nhịp tim mới ở trạng thái PENDING_UPLOAD và xin link tải lên S3 vào folder bảo mật records/."
          }
        },
        {
          "name": "3.2 (Simulate) Put CSV Record to S3 Presigned URL",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/csv"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "timestamp,red,infrared,green\n1000,50123,49876,30123\n1010,50125,49880,30125\n1020,50130,49885,30130\n"
            },
            "url": {
              "raw": "{{recordUploadUrl}}",
              "host": ["{{recordUploadUrl}}"]
            },
            "description": "Giả lập Client/Mobile App đẩy file CSV nhịp tim trực tiếp lên AWS S3."
          }
        },
        {
          "name": "3.3 Confirm Record Upload Completion",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health-records/{{recordId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health-records", "{{recordId}}", "confirm"]
            },
            "description": "Báo cáo Core Service là đã đẩy file lên S3 xong. Trạng thái bản ghi lập tức chuyển thành PROCESSING."
          }
        },
        {
          "name": "3.4 Get My Health Records",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health-records/my-records?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health-records", "my-records"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Lấy danh sách lịch sử đo nhịp tim của tôi có phân trang."
          }
        },
        {
          "name": "3.5 (Simulate) AI Service Callback",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recordId\": {{recordId}},\n  \"predictionLabel\": \"NORMAL\",\n  \"confidence\": 0.987,\n  \"hrvFeaturesJson\": \"{\\\"mean_nn\\\": 755.2, \\\"sdnn\\\": 48.5, \\\"rmssd\\\": 35.1}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/health-records/ai-callback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health-records", "ai-callback"]
            },
            "description": "Endpoint nội bộ (không cần token Bearer) dành cho AI Service gọi về cập nhật kết quả phân tích sau khi đọc file từ S3 xong."
          }
        }
      ]
    }
  ]
}
